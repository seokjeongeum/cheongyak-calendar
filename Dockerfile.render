FROM node:24-alpine AS web-build
WORKDIR /web
COPY web/package*.json ./
RUN npm ci --no-audit --no-fund --strict-ssl=true
COPY web/index.html web/tsconfig.json web/vite.config.ts ./
COPY web/src ./src
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STATIC_WEB_DIR=/app/static \
    PORT=10000
WORKDIR /app
COPY api/pyproject.toml ./
COPY api/app ./app
RUN pip install --no-cache-dir .
COPY --from=web-build /web/dist ./static

# A Free web instance runs only the API and browser app. Collection runs
# separately; LibreOffice is omitted to keep this image and runtime small.
# A durable external database is required because Render's filesystem expires.
EXPOSE 10000
CMD ["sh", "-c", ": \"${DATABASE_URL:?Connect a durable PostgreSQL database}\"; exec uvicorn app.main:app --host 0.0.0.0 --port \"${PORT:-10000}\" --workers 1"]
