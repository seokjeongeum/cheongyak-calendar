# Copy to .env for Docker Compose. Use a unique password before public deployment.
POSTGRES_DB=cheongyak
POSTGRES_USER=cheongyak
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Configure API keys in the web UI: 데이터 출처 → API 연결 설정.
# Service application/key issuance links are next to each input.
# Generate the administrator token once (no .env entry required):
# docker compose exec api python -m app.integration_settings
