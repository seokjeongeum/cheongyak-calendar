# Copy to .env for Docker Compose. Use a unique password before public deployment.
POSTGRES_DB=cheongyak
POSTGRES_USER=cheongyak
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Apply for each official API at data.go.kr; prefer its Decoding key.
# A shared key must be approved for every service that uses it.
DATA_GO_KR_API_KEY=
# Competition API is a separate service application:
# https://www.data.go.kr/data/15098905/openapi.do
# Prefer the approved Decoding key; blank uses DATA_GO_KR_API_KEY.
# Public official competition pages supplement an unapproved/unconfigured key.
CHEONGYAK_COMPETITION_API_KEY=
# LH: https://www.data.go.kr/data/15058530/openapi.do
# 한국토지주택공사_분양임대공고문 조회 서비스
LH_API_KEY=
MYHOME_API_KEY=
# iH: https://www.data.go.kr/data/15149725/openapi.do
# 인천도시공사_분양임대 관련 공고문 조회 서비스
# Development auto-approval; operating access requires review.
IH_API_KEY=

# Optional: only public announcement PDFs/HWP files are sent to the free Gemini API.
# No applicant profile information is sent. Leave blank to disable AI extraction.
GEMINI_API_KEY=
# Set to 1 only after confirming this key belongs to a Google project with
# billing disabled. A key alone never starts extraction.
GEMINI_UNBILLED_PROJECT_CONFIRMED=
